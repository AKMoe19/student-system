
  <style>
    body { background-color: #f4f6f9; }
    .table-responsive { min-height: 280px; }
  </style>

<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-panel">



  <!-- Main Container -->
  <div class="container pb-5">
    
    <!-- Header Section -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h4 class="fw-bold text-primary mb-1">
            <i class="fa-solid fa-chalkboard-user me-2"></i></i><%= classroom.className %>
          </h4>
          <p class="text-muted mb-0">Course : <strong><%= classroom.course %></strong> | <i class="fa-solid fa-person-chalkboard me-2"></i>Trainer : <strong><%= classroom.trainer || 'Unassigned' %></strong></p>
        </div>
        <div>
          <span class="badge bg-primary fs-6 px-3 py-2">
            Enrolled : <%= enrollments ? enrollments.length : 0 %> / <%= classroom.studentLimit %>
          </span>
        </div>
      </div>
    </div>

    <!-- Students Table -->
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3">
        <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-users me-2 text-primary"></i>Enrolled Students List</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover table-striped align-middle mb-0">

            <thead class="table-secondary">
              <tr>
                <th>#</th>
                <th>Student Name</th>
                <th>Course</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Enrollment Date</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>

            <tbody>
              <% if (!enrollments || enrollments.length === 0) { %>
                <tr>
                  <td colspan="8" class="text-center py-4 text-muted">ကျောင်းသား မရှိသေးပါ။</td>
                </tr>
              <% } else { %>
                <% enrollments.forEach((item, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><strong><%= item.student ? item.student.name : 'N/A' %></strong></td>
                    <td><span class="badge bg-light text-dark border"><%= item.course || classroom.course %></span></td>
                    <td><%= item.student ? item.student.email : '-' %></td>
                    <td><%= item.student ? item.student.phone : '-' %></td>
                    <td>
                      <% if (item.status === 'Active' || !item.status) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill"><%= item.status %></span>
                      <% } %>
                    </td>
                    <td><%= new Date(item.createdAt).toISOString().split('T')[0] %></td>
                    
                    <!-- Action Column -->
                    <td class="text-center">
                      <div class="dropdown">
                        <button class="btn btn-light btn-sm rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px; padding: 0;">
                          <i class="fa-solid fa-ellipsis-vertical text-secondary"></i>
                        </button>
                        
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 160px;">
                          <!-- 1. Change Classroom Option -->
                          <li>
                            <a class="dropdown-item text-primary fw-semibold py-2" href="#" onclick="openChangeClassModal('<%= item._id %>', `<%= item.student ? item.student.name : '' %>`, `<%= item.className %>`); return false;">
                              <i class="fa-solid fa-arrow-right-arrow-left me-2"></i> Change Class
                            </a>
                          </li>

                          <li><hr class="dropdown-divider my-1"></li>

                          <!-- 2. Edit Student Option -->
                          <li>
                            <a class="dropdown-item text-warning fw-semibold py-2" href="#" onclick="openEditStudentModal('<%= item.student ? item.student._id : '' %>', '<%= item.student ? item.student.name : '' %>', '<%= item.student ? item.student.email : '' %>', '<%= item.student ? item.student.phone : '' %>'); return false;">
                              <i class="fa-solid fa-pen-to-square me-2"></i> Edit Student
                            </a>
                          </li>

                          <li><hr class="dropdown-divider my-1"></li>

                          <!-- 3. Delete Enrollment Option -->
                          <li>
                            <form action="/delete-enrollment/<%= item._id %>" method="POST" onsubmit="return confirm('ဒီကျောင်းသားကို အတန်းစာရင်းမှ ဖျက်ရန် သေချာပါသလား?');">
                              <button type="submit" class="dropdown-item text-danger fw-semibold py-2">
                                <i class="fa-solid fa-trash me-2"></i> Delete
                              </button>
                            </form>
                          </li>
                        </ul>
                      </div>
                    </td>

                    <!-- Action Column -->
<td class="text-center">
  <div class="dropdown">
    <!-- 🔴 data-bs-popper-config ထည့်သွင်းထားပါသည် -->
    <button class="btn btn-light btn-sm rounded-circle shadow-sm" 
            type="button" 
            data-bs-toggle="dropdown" 
            data-bs-popper-config='{"strategy":"fixed"}'
            aria-expanded="false" 
            style="width: 32px; height: 32px; padding: 0;">
      <i class="fa-solid fa-ellipsis-vertical text-secondary"></i>
    </button>
    
    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 160px;">
      <!-- 1. Change Classroom Option -->
      <li>
        <a class="dropdown-item text-primary fw-semibold py-2" href="#" onclick="openChangeClassModal('<%= item._id %>', `<%= item.student ? item.student.name : '' %>`, `<%= item.className %>`); return false;">
          <i class="fa-solid fa-arrow-right-arrow-left me-2"></i> Change Class
        </a>
      </li>

      <li><hr class="dropdown-divider my-1"></li>

      <!-- 2. Edit Student Option -->
      <li>
        <a class="dropdown-item text-warning fw-semibold py-2" href="#" onclick="openEditStudentModal('<%= item.student ? item.student._id : '' %>', '<%= item.student ? item.student.name : '' %>', '<%= item.student ? item.student.email : '' %>', '<%= item.student ? item.student.phone : '' %>'); return false;">
          <i class="fa-solid fa-pen-to-square me-2"></i> Edit Student
        </a>
      </li>

      <li><hr class="dropdown-divider my-1"></li>

      <!-- 3. Delete Enrollment Option -->
      <li>
        <form action="/delete-enrollment/<%= item._id %>" method="POST" onsubmit="return confirm('ဒီကျောင်းသားကို အတန်းစာရင်းမှ ဖျက်ရန် သေချာပါသလား?');">
          <button type="submit" class="dropdown-item text-danger fw-semibold py-2">
            <i class="fa-solid fa-trash me-2"></i> Delete
          </button>
        </form>
      </li>
    </ul>
  </div>
</td>

                  </tr>
                <% }) %>
              <% } %>
            </tbody>

          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- CHANGE CLASSROOM MODAL -->
  <div class="modal fade" id="changeClassModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold"><i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Change Classroom</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="changeClassForm" action="" method="POST">
          <div class="modal-body">
            <p class="text-muted small">Student Name: <strong id="change_student_name" class="text-dark"></strong></p>
            <div class="mb-3">
              <label class="form-label small fw-bold">Select New Classroom</label>
              <select name="newClassName" id="change_class_select" class="form-select" required>
                <option value="">-- Classroom ရွေးပါ --</option>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary fw-bold"><i class="fa-solid fa-check me-1"></i> Confirm Change</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- EDIT STUDENT MODAL -->
  <div class="modal fade" id="editStudentModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-warning text-dark">
          <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Edit Student Info</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="editStudentForm" action="" method="POST">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label small fw-bold">Student Name</label>
              <input type="text" name="name" id="edit_student_name" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Email</label>
              <input type="email" name="email" id="edit_student_email" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">Phone</label>
              <input type="text" name="phone" id="edit_student_phone" class="form-control" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning fw-bold"><i class="fa-solid fa-floppy-disk me-1"></i> Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> -->
  <script>
    // Change Class Modal Function
    async function openChangeClassModal(enrollmentId, studentName, currentClassName) {
      document.getElementById('change_student_name').innerText = studentName;
      document.getElementById('changeClassForm').action = `/change-enrollment-class/${enrollmentId}`;

      const select = document.getElementById('change_class_select');
      select.innerHTML = '<option value="">Loading classrooms...</option>';

      const modal = new bootstrap.Modal(document.getElementById('changeClassModal'));
      modal.show();

      try {
        const res = await fetch('/api/classrooms');
        const classrooms = await res.json();

        select.innerHTML = '<option value="">-- Classroom ရွေးပါ --</option>';
        classrooms.forEach(cls => {
          if (cls.className !== currentClassName) {
            const opt = document.createElement('option');
            opt.value = cls.className;
            opt.textContent = `${cls.className} (${cls.course})`;
            select.appendChild(opt);
          }
        });
      } catch (err) {
        select.innerHTML = '<option value="">Error loading classrooms</option>';
      }
    }

    // Edit Student Modal Function
    function openEditStudentModal(studentId, name, email, phone) {
      document.getElementById('editStudentForm').action = `/edit-student/${studentId}`;
      document.getElementById('edit_student_name').value = name;
      document.getElementById('edit_student_email').value = email;
      document.getElementById('edit_student_phone').value = phone;

      const modal = new bootstrap.Modal(document.getElementById('editStudentModal'));
      modal.show();
    }
  </script>



    
</div>

<%- include('partials/footer') %>