<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Register</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Poppins', sans-serif; }
    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    /* Glowing Background Elements */
    .circle-1, .circle-2 {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      z-index: 0;
    }
    .circle-1 {
      width: 300px;
      height: 300px;
      background: rgba(16, 185, 129, 0.25);
      top: 10%;
      left: 15%;
    }
    .circle-2 {
      width: 350px;
      height: 350px;
      background: rgba(99, 102, 241, 0.25);
      bottom: 10%;
      right: 15%;
    }

    .register-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      padding: 2.5rem 2rem;
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      color: #fff;
    }

    .brand-icon {
      width: 65px;
      height: 65px;
      background: linear-gradient(135deg, #10b981, #059669);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      color: #fff;
      margin: 0 auto 1.2rem;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
    }

    .form-control {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      color: #fff;
      padding: 0.75rem 1rem 0.75rem 2.8rem;
      font-size: 0.95rem;
      transition: all 0.3s ease;
    }

    .form-control:focus {
      background: rgba(255, 255, 255, 0.15);
      border-color: #34d399;
      box-shadow: 0 0 15px rgba(52, 211, 153, 0.3);
      color: #fff;
    }

    .form-control::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .input-icon {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255, 255, 255, 0.6);
      z-index: 5;
      font-size: 1.1rem;
    }

    .btn-register {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border: none;
      border-radius: 12px;
      padding: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      color: #fff;
      box-shadow: 0 10px 20px rgba(16, 185, 129, 0.35);
      transition: all 0.3s ease;
    }

    .btn-register:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 25px rgba(16, 185, 129, 0.5);
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      color: #fff;
    }

    .btn-register:active {
      transform: translateY(0);
    }
  </style>
</head>
<body>

  <!-- Decorative Glow Circles -->
  <div class="circle-1"></div>
  <div class="circle-2"></div>

  <div class="register-card">
    <div class="brand-icon">
      <i class="fa-solid fa-user-plus"></i>
    </div>

    <h4 class="text-center fw-bold mb-1">Student Register</h4>
    <p class="text-center text-white-50 small mb-4">ကျောင်းတွင် စာရင်းသွင်းထားသော Email ဖြင့် အကောင့်ဖွင့်ပါ</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show border-0 py-2 px-3 mb-3 text-center" role="alert" style="background: rgba(239, 68, 68, 0.2); color: #fca5a5; font-size: 0.85rem; border-radius: 10px; backdrop-filter: blur(5px);">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> <%= error %>
      </div>
    <% } %>

    <form action="/register" method="POST">
      <!-- Email Field -->
      <div class="mb-3 position-relative">
        <i class="fa-solid fa-envelope input-icon"></i>
        <input 
          type="email" 
          name="email" 
          class="form-control" 
          placeholder="Enter Registered Email" 
          required 
          autocomplete="off"
        />
      </div>

      <!-- Password Field -->
      <div class="mb-4 position-relative">
        <i class="fa-solid fa-lock input-icon"></i>
        <input 
          type="password" 
          name="password" 
          class="form-control" 
          placeholder="Create Password" 
          required 
        />
      </div>

      <button type="submit" class="btn btn-register w-100 mb-3">
        Create Account <i class="fa-solid fa-arrow-right ms-1"></i>
      </button>
      
      <div class="text-center">
        <a href="/login" class="text-white-50 small text-decoration-none">
          <i class="fa-solid fa-arrow-left me-1"></i> အကောင့်ရှိပြီးသားဖြစ်ပါက Login ဝင်ရန်
        </a>
      </div>
    </form>
  </div>

</body>
</html>